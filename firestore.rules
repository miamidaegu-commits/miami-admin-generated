rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    function isAdmin() {
      return signedIn() && currentUserDoc().role == "admin";
    }

    function hasAdminClaim() {
      return signedIn() && request.auth.token.role == "admin";
    }

    function isTeacher() {
      return signedIn() && currentUserDoc().role == "teacher";
    }

    function isStudent() {
      return signedIn() && currentUserDoc().role == "student";
    }

    function myAcademyId() {
      return currentUserDoc().academyId;
    }

    function sameAcademy(data) {
      return data.academyId is string &&
        myAcademyId() is string &&
        data.academyId == myAcademyId();
    }

    function myStudentId() {
      return currentUserDoc().studentId;
    }

    function isMe(uid) {
      return signedIn() && currentUid() == uid;
    }

    function myTeacherName() {
      return currentUserDoc().teacherName;
    }

    function lessonBelongsToTeacher(data) {
      return isTeacher() &&
        (
          (data.teacherName is string && data.teacherName == myTeacherName()) ||
          (data.teacher is string && data.teacher == myTeacherName())
        );
    }

    function privateStudentBelongsToTeacher(data) {
      return isTeacher() &&
        (data.teacher is string && data.teacher == myTeacherName());
    }

    function groupClassBelongsToTeacher(data) {
      return isTeacher() &&
        (data.teacher is string && data.teacher == myTeacherName());
    }

    function studentPackageBelongsToTeacher(data) {
      return isTeacher() &&
        (data.teacher is string && data.teacher == myTeacherName());
    }

    function creditTransactionBelongsToTeacher(data) {
      return isTeacher() &&
        data.teacher is string &&
        data.teacher == myTeacherName();
    }

    function canManageAttendance() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canManageAttendance == true;
    }

    function canAddStudent() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canAddStudent == true;
    }

    function canEditStudent() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canEditStudent == true;
    }

    function canDeleteStudent() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canDeleteStudent == true;
    }

    function canEditLesson() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canEditLesson == true;
    }

    function canDeleteLesson() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canDeleteLesson == true;
    }

    function canCreateLessonDirectly() {
      return signedIn() &&
        currentUserDoc().role == "teacher" &&
        currentUserDoc().canCreateLessonDirectly == true &&
        currentUserDoc().requiresLessonApproval != true;
    }

    function canTeacherUpdateStudentPackageUsage() {
      return canManageAttendance() ||
        canCreateLessonDirectly() ||
        canEditLesson() ||
        canDeleteLesson();
    }

    function parentGroupClassBelongsToTeacher(groupClassId) {
      return isTeacher() &&
        get(/databases/$(database)/documents/groupClasses/$(groupClassId)).data.teacher == myTeacherName();
    }

    /** canonical groupClassId 우선, 없으면 iOS legacy groupClassID, 없으면 classID */
    function effectiveGroupClassIdFromData(data) {
      return data.groupClassId is string ? data.groupClassId
        : (data.groupClassID is string ? data.groupClassID
          : (data.classID is string ? data.classID : ""));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      // Bootstrapping AuthContext must not depend on reading users/{currentUid}
      // through another users/{currentUid} lookup.
      allow get: if isMe(uid) || hasAdminClaim();
      allow list: if hasAdminClaim();
      allow create: if isMe(uid) || hasAdminClaim();
      allow update: if isMe(uid) || hasAdminClaim();
      allow delete: if hasAdminClaim();
    }

    match /lessons/{lessonId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || lessonBelongsToTeacher(resource.data);
      allow create: if (isAdmin() && sameAcademy(request.resource.data)) || (
        canCreateLessonDirectly() &&
        lessonBelongsToTeacher(request.resource.data)
      );
      allow update: if (isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data)) || (
        canEditLesson() &&
        lessonBelongsToTeacher(resource.data) &&
        lessonBelongsToTeacher(request.resource.data) &&
        changedOnly(["date", "time", "subject", "startAt", "updatedAt"])
      ) || (
        canManageAttendance() &&
        lessonBelongsToTeacher(resource.data) &&
        lessonBelongsToTeacher(request.resource.data) &&
        changedOnly([
          "isDeductCancelled",
          "deductMemo",
          "updatedAt",
          "studentId",
          "studentName",
          "teacherName"
        ])
      );
      allow delete: if (isAdmin() && sameAcademy(resource.data)) || (
        canDeleteLesson() &&
        lessonBelongsToTeacher(resource.data)
      );
    }

    match /privateStudents/{studentId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || privateStudentBelongsToTeacher(resource.data);
      allow create: if (isAdmin() && sameAcademy(request.resource.data)) || (
        canAddStudent() &&
        privateStudentBelongsToTeacher(request.resource.data)
      );
      allow update: if (isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data)) || (
        canEditStudent() &&
        privateStudentBelongsToTeacher(resource.data) &&
        privateStudentBelongsToTeacher(request.resource.data) &&
        changedOnly([
          "name",
          "teacher",
          "phone",
          "carNumber",
          "learningPurpose",
          "firstRegisteredAt",
          "note",
          "updatedAt"
        ])
      ) || (
        canManageAttendance() &&
        privateStudentBelongsToTeacher(resource.data) &&
        changedOnly(["attendanceCount", "updatedAt"])
      );
      allow delete: if (isAdmin() && sameAcademy(resource.data)) || (
        canDeleteStudent() &&
        privateStudentBelongsToTeacher(resource.data)
      );
    }

    match /groupClasses/{groupClassId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || groupClassBelongsToTeacher(resource.data);
      allow create: if isAdmin() && sameAcademy(request.resource.data);
      allow update: if isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data);
      allow delete: if isAdmin() && sameAcademy(resource.data);
    }

    match /groupStudents/{groupStudentId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || (
        isTeacher() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data))
      );

      allow create: if (isAdmin() && sameAcademy(request.resource.data)) || (
        canAddStudent() &&
        effectiveGroupClassIdFromData(request.resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(request.resource.data))
      );

      allow update: if (isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data)) || (
        canManageAttendance() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        effectiveGroupClassIdFromData(request.resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data)) &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(request.resource.data)) &&
        changedOnly(["attendanceCount", "updatedAt"])
      );

      allow delete: if (isAdmin() && sameAcademy(resource.data)) || (
        canDeleteStudent() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data))
      );
    }

    match /groupLessons/{groupLessonId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || (
        isTeacher() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data))
      ) || (
        isStudent() &&
        sameAcademy(resource.data) &&
        resource.data.isBookable == true
      );

      allow create: if (isAdmin() && sameAcademy(request.resource.data)) || (
        canCreateLessonDirectly() &&
        effectiveGroupClassIdFromData(request.resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(request.resource.data))
      );

      allow update: if (isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data)) || (
        canEditLesson() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        effectiveGroupClassIdFromData(request.resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data)) &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(request.resource.data)) &&
        changedOnly([
          "groupClassId",
          "groupClassName",
          "teacher",
          "date",
          "time",
          "subject",
          "capacity",
          "bookedCount",
          "isBookable",
          "bookingMode",
          "updatedAt"
        ])
      ) || (
        canManageAttendance() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        effectiveGroupClassIdFromData(request.resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data)) &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(request.resource.data)) &&
        changedOnly(["countedStudentIDs", "attendanceAppliedAt", "updatedAt"])
      );

      allow delete: if (isAdmin() && sameAcademy(resource.data)) || (
        canDeleteLesson() &&
        effectiveGroupClassIdFromData(resource.data) != "" &&
        parentGroupClassBelongsToTeacher(effectiveGroupClassIdFromData(resource.data))
      );
    }

    match /studentPackages/{packageId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || studentPackageBelongsToTeacher(resource.data);
      allow create: if isAdmin() && sameAcademy(request.resource.data);
      allow update: if (isAdmin() && sameAcademy(resource.data) && sameAcademy(request.resource.data)) || (
        canTeacherUpdateStudentPackageUsage() &&
        studentPackageBelongsToTeacher(resource.data) &&
        studentPackageBelongsToTeacher(request.resource.data) &&
        changedOnly(["usedCount", "remainingCount", "status", "updatedAt"])
      );
      allow delete: if isAdmin() && sameAcademy(resource.data);
    }

    match /creditTransactions/{txId} {
      allow read: if isAdmin() && sameAcademy(resource.data);
      allow create: if (isAdmin() && sameAcademy(request.resource.data)) || canManageAttendance();
      allow update: if false;
      allow delete: if false;
    }

    match /groupLessonReservations/{reservationId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || (
        isStudent() &&
        sameAcademy(resource.data) &&
        resource.data.studentId == myStudentId()
      );
      allow create, update, delete: if false;
    }

    match /groupLessonCancelUsage/{usageId} {
      allow read: if (isAdmin() && sameAcademy(resource.data)) || (
        isStudent() &&
        sameAcademy(resource.data) &&
        resource.data.studentId == myStudentId()
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
