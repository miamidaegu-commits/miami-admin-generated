        data.time is string &&
        data.time != "" &&
        data.subject is string &&
        data.repeatWeekly is bool &&
        data.repeatWeeks is int &&
        data.repeatWeeks >= 1 &&
        data.repeatWeeks <= 60 &&
        data.approvalStatus in ["pending", "approved", "rejected"] &&
        data.createdAt is timestamp &&
        data.rejectionReason is string &&
        (
          !("seriesID" in data.keys()) ||
          data.seriesID is string
        );
    }

    function validLessonRequestCreateShape() {
      return request.resource.data.keys().hasOnly([
          "academyId",
          "teacherUID",
          "teacherName",
          "teacher",
          "studentID",
          "studentId",
          "studentName",
          "student",
          "date",
          "time",
          "subject",
          "repeatWeekly",
          "repeatWeeks",
          "approvalStatus",
          "status",
          "fixedPrivateTotalCount",
          "createdAt",
          "rejectionReason",
          "seriesID"
        ]) &&
        validLessonRequestCoreShape(request.resource.data) &&
        validLessonRequestTeacherFields(request.resource.data) &&
        request.resource.data.teacherUID == currentUid() &&
        request.resource.data.approvalStatus == "pending" &&
        (
          !("status" in request.resource.data.keys()) ||
          request.resource.data.status == "pending"
        ) &&
        (
          !("fixedPrivateTotalCount" in request.resource.data.keys()) ||
          (
            request.resource.data.fixedPrivateTotalCount is int &&
            request.resource.data.fixedPrivateTotalCount >= 1 &&
            request.resource.data.fixedPrivateTotalCount <= 300
          )
        );
    }

    function validTeacherQuickPrivateStudentCreateShape() {
      return request.resource.data.keys().hasOnly([
          "academyId",
          "name",
          "teacher",
          "status",
          "studentStatus",
          "profileStatus",
          "createdByUid",
          "createdByRole",
          "createdAt",
          "updatedAt",
          "paidLessons",
          "attendanceCount",
          "weeklyFrequency",
          "slots"
        ]) &&
        request.resource.data.academyId is string &&
        request.resource.data.academyId != "" &&
        request.resource.data.name is string &&
        request.resource.data.name != "" &&
        privateStudentBelongsToTeacher(request.resource.data) &&
        request.resource.data.status == "active" &&
        request.resource.data.studentStatus == "active" &&
        request.resource.data.profileStatus == "incomplete" &&
        request.resource.data.createdByUid == currentUid() &&
        request.resource.data.createdByRole == "teacher" &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.attendanceCount == 0 &&
        (
          !("paidLessons" in request.resource.data.keys()) ||
          (
            request.resource.data.paidLessons is int &&
            request.resource.data.paidLessons >= 1 &&
            request.resource.data.paidLessons <= 300
          )
        ) &&
        (
          !("weeklyFrequency" in request.resource.data.keys()) ||
          (
            request.resource.data.weeklyFrequency is int &&
            request.resource.data.weeklyFrequency in [1, 2, 3]
          )
        ) &&
        (
          !("slots" in request.resource.data.keys()) ||
          request.resource.data.slots is list
        );
    }

    function validLessonRequestReviewFields(data) {
      return (
          !("status" in data.keys()) ||
          data.status in ["pending", "approved", "rejected"]
        ) &&
        (
          !("requestStatus" in data.keys()) ||
          data.requestStatus in ["pending", "approved", "rejected"]
        ) &&
        (
          !("updatedAt" in data.keys()) ||
          data.updatedAt is timestamp
        ) &&
        (
          !("reviewedAt" in data.keys()) ||
          data.reviewedAt is timestamp
        ) &&
        (
          !("approvedAt" in data.keys()) ||
          data.approvedAt is timestamp
        ) &&
        (
          !("rejectedAt" in data.keys()) ||
          data.rejectedAt is timestamp
        ) &&
        (
          !("reviewedBy" in data.keys()) ||
          data.reviewedBy is string
        ) &&
        (
          !("reviewedByUID" in data.keys()) ||
          data.reviewedByUID is string
        ) &&
        (
          !("reviewedByName" in data.keys()) ||
          data.reviewedByName is string
        ) &&
        (
          !("approvedBy" in data.keys()) ||
          data.approvedBy is string
        ) &&
        (
          !("approvedByUID" in data.keys()) ||
          data.approvedByUID is string
        ) &&
        (
          !("approvedByName" in data.keys()) ||
          data.approvedByName is string
        ) &&
        (
          !("rejectedBy" in data.keys()) ||
          data.rejectedBy is string
        ) &&
        (
          !("rejectedByUID" in data.keys()) ||
          data.rejectedByUID is string
        ) &&
        (
          !("rejectedByName" in data.keys()) ||
          data.rejectedByName is string
        ) &&
        (
          !("lessonId" in data.keys()) ||
          data.lessonId is string
        ) &&
        (
          !("lessonID" in data.keys()) ||
          data.lessonID is string
        ) &&
        (
          !("fixedPrivatePackageId" in data.keys()) ||
          data.fixedPrivatePackageId is string
        );
    }

    function lessonRequestReviewUpdateFields() {
      return [
        "approvalStatus",
        "status",
        "requestStatus",
        "rejectionReason",
        "updatedAt",
        "reviewedAt",
        "reviewedBy",
        "reviewedByUID",
        "reviewedByName",
        "approvedAt",
        "approvedBy",
        "approvedByUID",
        "approvedByName",
        "rejectedAt",
        "rejectedBy",
        "rejectedByUID",
        "rejectedByName",
        "lessonId",
        "lessonID",
        "fixedPrivatePackageId"
      ];
    }

    function validLessonRequestReviewChangesOnly() {
      return changedOnly(lessonRequestReviewUpdateFields());
    }

    function validLessonRequestReviewShape() {
      return request.resource.data.keys().hasOnly([
          "academyId",
          "teacherUID",
          "teacherName",
          "teacher",
          "studentID",
          "studentId",
          "studentName",
          "student",
          "date",
          "time",
          "subject",
          "repeatWeekly",
          "repeatWeeks",
          "repeat",
          "isRecurring",
          "repeatEnabled",
          "repeatCount",
          "count",
          "totalCount",
          "lessonCount",
          "numberOfLessons",
          "recurrenceCount",
          "sessions",
          "durationWeeks",
          "approvalStatus",
          "status",
          "requestStatus",
          "fixedPrivateTotalCount",
          "createdAt",
          "rejectionReason",
          "seriesID",
          "updatedAt",
          "reviewedAt",
          "reviewedBy",
          "reviewedByUID",
          "reviewedByName",
          "approvedAt",
          "approvedBy",
          "approvedByUID",
          "approvedByName",
          "rejectedAt",
          "rejectedBy",
          "rejectedByUID",
          "rejectedByName",
          "lessonId",
          "lessonID",
          "fixedPrivatePackageId"
        ]) &&
        validLessonRequestCoreShape(request.resource.data) &&
        validLessonRequestStoredTeacherFields(request.resource.data) &&
        validLessonRequestReviewFields(request.resource.data);
    }

    function validLessonRequestReviewUpdate() {
      return validLessonRequestReviewShape() &&
        resource.data.approvalStatus == "pending" &&
        request.resource.data.approvalStatus in ["approved", "rejected"] &&
        validLessonRequestReviewChangesOnly();
    }

    match /users/{uid} {
      allow get: if isMe(uid) || hasAdminClaim();
      allow list: if hasAdminClaim();
      allow create: if isMe(uid) || hasAdminClaim();
      allow update: if isMe(uid) || hasAdminClaim();
      allow delete: if hasAdminClaim();
    }

    match /academies/{academyId} {
      allow read: if isAcademyMember(academyId);
      allow create, update, delete: if false;
    }

    match /academyMemberships/{membershipId} {
      allow read: if canReadAcademyMembership(resource.data);
      allow create, delete: if false;
      allow update: if validTeacherPermissionUpdate();
    }

    match /teachers/{teacherId} {
      allow get, list: if sameAcademyOnRead();
      allow create: if sameAcademyOnCreate() &&
        isAcademyAdmin(request.resource.data.academyId);
      allow update: if sameAcademyOnUpdate() &&
        request.resource.data.academyId == resource.data.academyId &&
        isAcademyAdmin(resource.data.academyId);
      allow delete: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);
    }

    match /lessons/{lessonId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        lessonBelongsToTeacher(resource.data) ||
        lessonBelongsToCurrentStudent(resource.data)
      );
      allow create: if sameAcademyOnCreate() && (
        isAcademyAdmin(request.resource.data.academyId) ||
        (
          canCreateLessonDirectly(request.resource.data.academyId) &&
          lessonBelongsToTeacher(request.resource.data)
        )
      );
      allow update: if sameAcademyOnUpdate() && (
        isAcademyAdmin(resource.data.academyId) || (
          canEditLesson(resource.data.academyId) &&
          lessonBelongsToTeacher(resource.data) &&
          lessonBelongsToTeacher(request.resource.data) &&
          changedOnly(["date", "time", "subject", "startAt", "updatedAt"])
        ) || (
          (canManageAttendance(resource.data.academyId) ||
            canManageOwnLessonDeductions(resource.data.academyId)) &&
          lessonBelongsToTeacher(resource.data) &&
          changedOnly([
            "isDeductCancelled",
            "deductMemo",
            "updatedAt",
            "studentId",
            "studentName",
            "teacherName"
          ])
        )
      );
      allow delete: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          canDeleteLesson(resource.data.academyId) &&
          lessonBelongsToTeacher(resource.data)
        )
      );
    }

    match /lessonRequests/{requestId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        lessonRequestBelongsToTeacher(resource.data)
      );

      allow create: if sameAcademyOnCreate() &&
        isAcademyTeacherOrStaff(request.resource.data.academyId) &&
        validLessonRequestCreateShape();

      allow update: if sameAcademyOnUpdate() &&
        isAcademyAdmin(resource.data.academyId) &&
        validLessonRequestReviewUpdate();

      allow delete: if false;
    }

    match /privateStudents/{studentId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        privateStudentBelongsToTeacher(resource.data)
      );
      allow create: if sameAcademyOnCreate() && (
        isAcademyAdmin(request.resource.data.academyId) ||
        validTeacherQuickPrivateStudentCreateShape() ||
        (
          canAddStudent(request.resource.data.academyId) &&
          privateStudentBelongsToTeacher(request.resource.data)
        )
      );
      allow update: if sameAcademyOnUpdate() && (
        isAcademyAdmin(resource.data.academyId) || (
          canEditStudent(resource.data.academyId) &&
          privateStudentBelongsToTeacher(resource.data) &&
          privateStudentBelongsToTeacher(request.resource.data) &&
          changedOnly([
            "name",
            "teacher",
            "phone",
            "carNumber",
            "learningPurpose",
            "firstRegisteredAt",
            "note",
            "updatedAt"
          ])
        ) || (
          canManageAttendance(resource.data.academyId) &&
          privateStudentBelongsToTeacher(resource.data) &&
          changedOnly(["attendanceCount", "updatedAt"])
        )
      );
      allow delete: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          canDeleteStudent(resource.data.academyId) &&
          privateStudentBelongsToTeacher(resource.data)
        )
      );
    }

    match /groupClasses/{groupClassId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        groupClassBelongsToTeacher(resource.data)
      );
      allow create: if sameAcademyOnCreate() &&
        (
          isAcademyAdmin(request.resource.data.academyId) ||
          (
            isAcademyTeacherOrStaff(request.resource.data.academyId) &&
            validTeacherGroupClassShape(request.resource.data) &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.updatedAt == request.time
          )
        );
      allow update: if sameAcademyOnUpdate() &&
        (
          isAcademyAdmin(resource.data.academyId) ||
          (
            groupClassBelongsToTeacher(resource.data) &&
            validTeacherGroupClassShape(request.resource.data) &&
            request.resource.data.academyId == resource.data.academyId &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time
          )
        );
      allow delete: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);
    }

    match /groupStudents/{groupStudentId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          effectiveGroupClassIdFromData(resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          )
        )
      );

      allow create: if sameAcademyOnCreate() && (
        isAcademyAdmin(request.resource.data.academyId) ||
        (
          canAddStudent(request.resource.data.academyId) &&
          effectiveGroupClassIdFromData(request.resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            request.resource.data.academyId,
            effectiveGroupClassIdFromData(request.resource.data)
          )
        )
      );

      allow update: if sameAcademyOnUpdate() && (
        isAcademyAdmin(resource.data.academyId) || (
          canManageAttendance(resource.data.academyId) &&
          effectiveGroupClassIdFromData(resource.data) != "" &&
          effectiveGroupClassIdFromData(request.resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          ) &&
          parentGroupClassBelongsToTeacher(
            request.resource.data.academyId,
            effectiveGroupClassIdFromData(request.resource.data)
          ) &&
          changedOnly(["attendanceCount", "updatedAt"])
        )
      );

      allow delete: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          canDeleteStudent(resource.data.academyId) &&
          effectiveGroupClassIdFromData(resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          )
        )
      );
    }

    match /studentGroupAccess/{accessId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          hasStudentIdentity(resource.data.academyId) &&
          resource.data.studentId == myStudentId(resource.data.academyId)
        ) ||
        (
          resource.data.groupClassId is string &&
          parentGroupClassBelongsToTeacher(resource.data.academyId, resource.data.groupClassId)
        )
      );

      allow create: if sameAcademyOnCreate() &&
        accessId ==
          request.resource.data.academyId + "__" +
          request.resource.data.groupClassId + "__" +
          request.resource.data.studentId &&
        validStudentGroupAccessShape(request.resource.data) &&
        (
          isAcademyAdmin(request.resource.data.academyId) ||
          (
            canAddStudent(request.resource.data.academyId) &&
            parentGroupClassBelongsToTeacher(
              request.resource.data.academyId,
              request.resource.data.groupClassId
            )
          )
        );

      allow update: if sameAcademyOnUpdate() &&
        accessId ==
          resource.data.academyId + "__" +
          resource.data.groupClassId + "__" +
          resource.data.studentId &&
        request.resource.data.groupClassId == resource.data.groupClassId &&
        request.resource.data.studentId == resource.data.studentId &&
        validStudentGroupAccessShape(request.resource.data) &&
        (
          isAcademyAdmin(resource.data.academyId) ||
          (
            resource.data.groupClassId is string &&
            parentGroupClassBelongsToTeacher(resource.data.academyId, resource.data.groupClassId) &&
            (
              canAddStudent(resource.data.academyId) ||
              canEditStudent(resource.data.academyId) ||
              canDeleteStudent(resource.data.academyId)
            )
          )
        );

      allow delete: if sameAcademyOnRead() &&
        accessId ==
          resource.data.academyId + "__" +
          resource.data.groupClassId + "__" +
          resource.data.studentId &&
        (
          isAcademyAdmin(resource.data.academyId) ||
          (
            canDeleteStudent(resource.data.academyId) &&
            resource.data.groupClassId is string &&
            parentGroupClassBelongsToTeacher(resource.data.academyId, resource.data.groupClassId)
          )
        );
    }

    match /studentGroupAccessSummary/{summaryId} {
      allow get: if signedIn() &&
        !exists(/databases/$(database)/documents/studentGroupAccessSummary/$(summaryId));

      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          hasStudentIdentity(resource.data.academyId) &&
          resource.data.studentId == myStudentId(resource.data.academyId)
        )
      );

      allow create: if sameAcademyOnCreate() &&
        summaryId ==
          request.resource.data.academyId + "__" +
          request.resource.data.studentId &&
        validStudentGroupAccessSummaryShape(request.resource.data) &&
        (
          isAcademyAdmin(request.resource.data.academyId) ||
          (
            canAddStudent(request.resource.data.academyId) ||
            canEditStudent(request.resource.data.academyId) ||
            canDeleteStudent(request.resource.data.academyId)
          )
        );

      allow update: if sameAcademyOnUpdate() &&
        summaryId ==
          resource.data.academyId + "__" +
          resource.data.studentId &&
        request.resource.data.studentId == resource.data.studentId &&
        validStudentGroupAccessSummaryShape(request.resource.data) &&
        (
          isAcademyAdmin(resource.data.academyId) ||
          (
            canAddStudent(resource.data.academyId) ||
            canEditStudent(resource.data.academyId) ||
            canDeleteStudent(resource.data.academyId)
          )
        );

      allow delete: if false;
    }

    match /studentPrivateAccessSummary/{summaryId} {
      allow get: if signedIn() &&
        !exists(/databases/$(database)/documents/studentPrivateAccessSummary/$(summaryId));

      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          hasStudentIdentity(resource.data.academyId) &&
          resource.data.studentId == myStudentId(resource.data.academyId)
        )
      );

      allow create: if sameAcademyOnCreate() &&
        isAcademyAdmin(request.resource.data.academyId) &&
        summaryId ==
          request.resource.data.academyId + "__" +
          request.resource.data.studentId &&
        validStudentPrivateAccessSummaryShape(request.resource.data);

      allow update: if sameAcademyOnUpdate() &&
        isAcademyAdmin(resource.data.academyId) &&
        summaryId ==
          resource.data.academyId + "__" +
          resource.data.studentId &&
        request.resource.data.studentId == resource.data.studentId &&
        validStudentPrivateAccessSummaryShape(request.resource.data);

      allow delete: if false;
    }

    match /studentPrivateBookingStats/{statsId} {
      allow read: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);

      allow create, update, delete: if false;
    }

    match /privateLessonSlots/{slotId} {
      allow get: if (
        sameAcademyOnRead() && (
          isAcademyAdmin(resource.data.academyId) ||
          privateSlotBelongsToTeacher(resource.data) ||
          privateSlotVisibleToCurrentStudent(resource.data, slotId)
        )
      );

      allow list: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        privateSlotBelongsToTeacher(resource.data) ||
        privateSlotVisibleToCurrentStudent(resource.data, slotId)
      );

      allow create: if sameAcademyOnCreate() &&
        isAcademyAdmin(request.resource.data.academyId) &&
        (
          validPrivateSlotCreateShape() ||
          validPrivateFixedSlotAdminCreateShape()
        );

      allow update: if sameAcademyOnUpdate() && (
        (
          isAcademyAdmin(resource.data.academyId) &&
          validPrivateSlotManagerEligibilityUpdate()
        ) ||
        (
          isAcademyAdmin(resource.data.academyId) &&
          (
            validPrivateSlotManagerCancelOpen() ||
            validPrivateSlotManagerCancelReservedSlot(slotId) ||
            validPrivateSlotManagerCancelReservation(slotId)
          )
        )
      );

      allow delete: if false;
    }

    match /privateLessonAvailabilityTemplates/{templateId} {
      allow read: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);

      allow create: if sameAcademyOnCreate() &&
        isAcademyAdmin(request.resource.data.academyId) &&
        validPrivateAvailabilityTemplateShape(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if sameAcademyOnUpdate() &&
        isAcademyAdmin(resource.data.academyId) &&
        validPrivateAvailabilityTemplateShape(request.resource.data) &&
        request.resource.data.academyId == resource.data.academyId &&
        request.resource.data.teacher == resource.data.teacher &&
        request.resource.data.teacherKey == resource.data.teacherKey &&
        request.resource.data.weekday == resource.data.weekday &&
        request.resource.data.time == resource.data.time &&
        request.resource.data.durationMinutes == resource.data.durationMinutes &&
        request.resource.data.createdAt == resource.data.createdAt &&
        changedOnly([
          "status",
          "effectiveStartDate",
          "effectiveEndDate",
          "useForFixedAssignment",
          "openForStudentBooking",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /privateLessonReservations/{reservationId} {
      allow get: if signedIn() &&
        !exists(/databases/$(database)/documents/privateLessonReservations/$(reservationId));

      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          isAcademyTeacherOrStaff(resource.data.academyId) &&
          (
            resource.data.teacher == myAcademyTeacherName(resource.data.academyId) ||
            resource.data.teacherName == myAcademyTeacherName(resource.data.academyId)
          )
        ) ||
        (
          hasStudentIdentity(resource.data.academyId) &&
          resource.data.studentId == myStudentId(resource.data.academyId)
        )
      );

      allow create: if sameAcademyOnCreate() &&
        (
          validPrivateReservationStudentCreate(reservationId) ||
          (
            isAcademyAdmin(request.resource.data.academyId) &&
            validPrivateFixedReservationAdminCreate(reservationId)
          )
        );

      allow update: if sameAcademyOnUpdate() && (
        (
          hasStudentIdentity(resource.data.academyId) &&
          resource.data.studentId == myStudentId(resource.data.academyId) &&
          (
            validPrivateReservationReactivate(reservationId) ||
            validPrivateReservationCancel(reservationId)
          )
        ) ||
        (
          isAcademyAdmin(resource.data.academyId) &&
          validPrivateReservationManagerCancel(reservationId)
        )
      );

      allow delete: if false;
    }

    match /dailyMaterials/{materialId} {
      allow read: if canReadDailyMaterial(resource.data);

      allow create: if sameAcademyOnCreate() &&
        materialId == request.resource.data.academyId + "__" + request.resource.data.date &&
        isAcademyAdmin(request.resource.data.academyId) &&
        validDailyMaterialCreate();

      allow update: if sameAcademyOnUpdate() &&
        materialId == resource.data.academyId + "__" + resource.data.date &&
        request.resource.data.date == resource.data.date &&
        isAcademyAdmin(resource.data.academyId) &&
        validDailyMaterialUpdate();

      allow delete: if false;
    }

    match /groupLessons/{groupLessonId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          effectiveGroupClassIdFromData(resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          )
        ) ||
        (
          resource.data.isBookable == true &&
          (
            (
              resource.data.groupClassId is string &&
              resource.data.groupClassId != "" &&
              hasActiveStudentGroupAccess(resource.data.academyId, resource.data.groupClassId)
            ) ||
            hasActiveStudentGroupCourseTypeAccessForStudent(
              resource.data.academyId,
              myStudentId(resource.data.academyId),
              resource.data.groupCourseType
            )
          )
        )
      );

      allow create: if sameAcademyOnCreate() && (
        isAcademyAdmin(request.resource.data.academyId) ||
        (
          canCreateLessonDirectly(request.resource.data.academyId) &&
          effectiveGroupClassIdFromData(request.resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            request.resource.data.academyId,
            effectiveGroupClassIdFromData(request.resource.data)
          )
        )
      );

      allow update: if sameAcademyOnUpdate() && (
        isAcademyAdmin(resource.data.academyId) || (
          canEditLesson(resource.data.academyId) &&
          effectiveGroupClassIdFromData(resource.data) != "" &&
          effectiveGroupClassIdFromData(request.resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          ) &&
          parentGroupClassBelongsToTeacher(
            request.resource.data.academyId,
            effectiveGroupClassIdFromData(request.resource.data)
          ) &&
          changedOnly([
            "groupClassId",
            "groupClassName",
            "teacher",
            "date",
            "time",
            "subject",
            "capacity",
            "isBookable",
            "updatedAt"
          ])
        ) || (
          canManageAttendance(resource.data.academyId) &&
          effectiveGroupClassIdFromData(resource.data) != "" &&
          effectiveGroupClassIdFromData(request.resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          ) &&
          parentGroupClassBelongsToTeacher(
            request.resource.data.academyId,
            effectiveGroupClassIdFromData(request.resource.data)
          ) &&
          changedOnly(["countedStudentIDs", "attendanceAppliedAt", "updatedAt"])
        )
      );

      allow delete: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          canDeleteLesson(resource.data.academyId) &&
          effectiveGroupClassIdFromData(resource.data) != "" &&
          parentGroupClassBelongsToTeacher(
            resource.data.academyId,
            effectiveGroupClassIdFromData(resource.data)
          )
        )
      );
    }

    match /groupLessonReservations/{reservationId} {
      allow get: if signedIn() &&
        !exists(/databases/$(database)/documents/groupLessonReservations/$(reservationId));

      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        (
          resource.data.groupClassId is string &&
          parentGroupClassBelongsToTeacher(resource.data.academyId, resource.data.groupClassId)
        ) ||
        studentOwnsReservation(resource.data)
      );

      allow create: if sameAcademyOnCreate() &&
        reservationId ==
          request.resource.data.academyId + "__" +
          request.resource.data.lessonId + "__" +
          request.resource.data.studentId &&
        request.resource.data.groupClassId is string &&
        request.resource.data.lessonId is string &&
        request.resource.data.studentId is string &&
        (
          (
            request.resource.data.status == "active" &&
            request.resource.data.source == "dashboard" &&
            (
              isAcademyAdmin(request.resource.data.academyId) ||
              parentGroupClassBelongsToTeacher(
                request.resource.data.academyId,
                request.resource.data.groupClassId
              )
            )
          )
        )
      ;

      allow update: if sameAcademyOnUpdate() &&
        reservationId ==
          resource.data.academyId + "__" +
          resource.data.lessonId + "__" +
          resource.data.studentId &&
        request.resource.data.lessonId == resource.data.lessonId &&
        request.resource.data.groupClassId == resource.data.groupClassId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.status in ["active", "cancelled"] &&
        request.resource.data.source == resource.data.source &&
        (
          (
            changedOnly(["status", "updatedAt", "cancelledAt"]) &&
            request.resource.data.source == "dashboard" &&
            (
              isAcademyAdmin(resource.data.academyId) ||
              parentGroupClassBelongsToTeacher(resource.data.academyId, resource.data.groupClassId)
            )
          ) ||
          (
            isAcademyAdmin(resource.data.academyId) &&
            resource.data.status == "active" &&
            request.resource.data.status == "cancelled" &&
            request.resource.data.noDeduction == true &&
            request.resource.data.cancellationType in ["no_deduction", "class_closure"] &&
            request.resource.data.cancelledReason in [
              "holiday",
              "teacher_unavailable",
              "academy_closed",
              "other",
              "group_class_closed"
            ] &&
            request.resource.data.cancelledAt is timestamp &&
            request.resource.data.updatedAt is timestamp &&
            (!("cancelledByUid" in request.resource.data.keys()) ||
              request.resource.data.cancelledByUid is string) &&
            (!("cancellationNote" in request.resource.data.keys()) ||
              request.resource.data.cancellationNote is string) &&
            (!("date" in request.resource.data.keys()) ||
              request.resource.data.date is string) &&
            (!("time" in request.resource.data.keys()) ||
              request.resource.data.time is string) &&
            (!("subject" in request.resource.data.keys()) ||
              request.resource.data.subject is string) &&
            changedOnly([
              "status",
              "cancellationType",
              "cancelledReason",
              "cancellationNote",
              "noDeduction",
              "cancelledAt",
              "cancelledByUid",
              "date",
              "time",
              "subject",
              "updatedAt"
            ])
          )
        );

      allow delete: if false;
    }

    match /studentPackages/{packageId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        studentPackageBelongsToTeacher(resource.data) ||
        studentPackageBelongsToCurrentStudent(resource.data)
      );
      allow create: if sameAcademyOnCreate() &&
        isAcademyAdmin(request.resource.data.academyId);
      allow update: if sameAcademyOnUpdate() && (
        isAcademyAdmin(resource.data.academyId) || (
          canTeacherUpdateStudentPackageUsage(resource.data.academyId) &&
          resource.data.packageType in ["group", "openGroup"] &&
          request.resource.data.packageType == resource.data.packageType &&
          studentPackageBelongsToTeacher(resource.data) &&
          studentPackageBelongsToTeacher(request.resource.data) &&
          changedOnly(["usedCount", "remainingCount", "status", "updatedAt"])
        ) || (
          validTeacherStudentPackageCountUpdate()
        )
      );
      allow delete: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);
    }

    match /creditTransactions/{txId} {
      allow read: if sameAcademyOnRead() &&
        isAcademyAdmin(resource.data.academyId);
      allow create: if sameAcademyOnCreate() && (
        isAcademyAdmin(request.resource.data.academyId) ||
        (
          canManageAttendance(request.resource.data.academyId) &&
          creditTransactionBelongsToTeacher(request.resource.data)
        )
      );
      allow update: if false;
      allow delete: if false;
    }

    match /notificationEvents/{eventId} {
      allow read: if sameAcademyOnRead() && (
        isAcademyAdmin(resource.data.academyId) ||
        notificationEventBelongsToTeacher(resource.data)
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
