rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function hasAdminClaim() {
      return signedIn() && request.auth.token.role == "admin";
    }

    function isMe(uid) {
      return signedIn() && currentUid() == uid;
    }

    function membershipPath(academyId) {
      return /databases/$(database)/documents/academyMemberships/$(academyId + "_" + currentUid());
    }

    function myMembership(academyId) {
      return get(membershipPath(academyId)).data;
    }

    function isAcademyMember(academyId) {
      return signedIn() &&
        academyId is string &&
        academyId != "" &&
        academyId != "academy_default" &&
        exists(membershipPath(academyId)) &&
        myMembership(academyId).status == "active";
    }

    function isAcademyAdmin(academyId) {
      return isAcademyMember(academyId) &&
        (myMembership(academyId).role == "owner" || myMembership(academyId).role == "admin");
    }

    function isAcademyTeacherOrStaff(academyId) {
      return isAcademyMember(academyId) &&
        (myMembership(academyId).role == "teacher" || myMembership(academyId).role == "staff");
    }

    function myAcademyTeacherName(academyId) {
      return myMembership(academyId).teacherName;
    }

    function sameAcademyOnCreate() {
      return request.resource.data.academyId is string &&
        isAcademyMember(request.resource.data.academyId);
    }

    function sameAcademyOnUpdate() {
      return resource.data.academyId is string &&
        request.resource.data.academyId == resource.data.academyId &&
        isAcademyMember(resource.data.academyId);
    }

    function sameAcademyOnRead() {
      return resource.data.academyId is string &&
        isAcademyMember(resource.data.academyId);
    }

    function lessonBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        (
          (data.teacherName is string && data.teacherName == myAcademyTeacherName(data.academyId)) ||
          (data.teacher is string && data.teacher == myAcademyTeacherName(data.academyId))
        );
    }

    function lessonBelongsToCurrentStudent(data) {
      return hasStudentIdentity(data.academyId) &&
        (
          (data.studentId is string && data.studentId == myStudentId(data.academyId)) ||
          (data.studentID is string && data.studentID == myStudentId(data.academyId))
        );
    }

    function privateStudentBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        (data.teacher is string && data.teacher == myAcademyTeacherName(data.academyId));
    }

    function groupClassBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        (
          (data.teacher is string && data.teacher == myAcademyTeacherName(data.academyId)) ||
          (data.teacherName is string && data.teacherName == myAcademyTeacherName(data.academyId))
        );
    }

    function studentPackageBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        (
          (data.teacher is string && data.teacher == myAcademyTeacherName(data.academyId)) ||
          (data.teacherName is string && data.teacherName == myAcademyTeacherName(data.academyId))
        );
    }

    function studentPackageBelongsToCurrentStudent(data) {
      return hasStudentIdentity(data.academyId) &&
        data.studentId is string &&
        data.studentId == myStudentId(data.academyId);
    }

    function creditTransactionBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        data.teacher is string &&
        data.teacher == myAcademyTeacherName(data.academyId);
    }

    function notificationEventBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        (
          (data.teacher is string && data.teacher == myAcademyTeacherName(data.academyId)) ||
          (data.teacherName is string && data.teacherName == myAcademyTeacherName(data.academyId))
        );
    }

    function canManageAttendance(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canManageAttendance == true;
    }

    function canAddStudent(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canAddStudent == true;
    }

    function canEditStudent(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canEditStudent == true;
    }

    function canDeleteStudent(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canDeleteStudent == true;
    }

    function canEditLesson(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canEditLesson == true;
    }

    function canDeleteLesson(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canDeleteLesson == true;
    }

    function canCreateLessonDirectly(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canCreateLessonDirectly == true &&
        myMembership(academyId).permissions.requiresLessonApproval != true;
    }

    function canEditStudentPackageCounts(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canEditStudentPackageCounts == true;
    }

    function canManageOwnLessonDeductions(academyId) {
      return isAcademyTeacherOrStaff(academyId) &&
        myMembership(academyId).permissions.canManageOwnLessonDeductions == true;
    }

    function canTeacherUpdateStudentPackageUsage(academyId) {
      return canManageAttendance(academyId) ||
        canManageOwnLessonDeductions(academyId) ||
        canCreateLessonDirectly(academyId) ||
        canEditLesson(academyId) ||
        canDeleteLesson(academyId);
    }

    function validTeacherStudentPackageCountUpdate() {
      return false;
    }

    function parentGroupClassBelongsToTeacher(academyId, groupClassId) {
      return isAcademyTeacherOrStaff(academyId) &&
        get(/databases/$(database)/documents/groupClasses/$(groupClassId)).data.academyId == academyId &&
        groupClassBelongsToTeacher(
          get(/databases/$(database)/documents/groupClasses/$(groupClassId)).data
        );
    }

    /** canonical groupClassId first, then legacy iOS groupClassID, then classID */
    function effectiveGroupClassIdFromData(data) {
      return data.groupClassId is string ? data.groupClassId
        : (data.groupClassID is string ? data.groupClassID
          : (data.classID is string ? data.classID : ""));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validBookedCountDelta() {
      return request.resource.data.bookedCount is int &&
        resource.data.bookedCount is int &&
        request.resource.data.bookedCount >= 0 &&
        request.resource.data.bookedCount <= resource.data.capacity &&
        (
          request.resource.data.bookedCount == resource.data.bookedCount + 1 ||
          request.resource.data.bookedCount == resource.data.bookedCount - 1
        );
    }

    function hasStudentIdentity(academyId) {
      return isAcademyMember(academyId) &&
        myMembership(academyId).role == "student" &&
        myMembership(academyId).studentId is string &&
        myMembership(academyId).studentId != "";
    }

    function canReadAcademyMembership(data) {
      return signedIn() &&
        data.academyId is string &&
        data.academyId != "" &&
        data.academyId != "academy_default" &&
        (
          (data.uid is string && data.uid == currentUid()) ||
          isAcademyAdmin(data.academyId)
        );
    }

    function validTeacherPermissionUpdate() {
      return resource.data.academyId is string &&
        request.resource.data.academyId == resource.data.academyId &&
        isAcademyAdmin(resource.data.academyId) &&
        resource.data.role == "teacher" &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.teacherName == resource.data.teacherName &&
        changedOnly(["permissions", "updatedAt"]) &&
        resource.data.permissions is map &&
        request.resource.data.permissions is map &&
        request.resource.data.permissions.diff(resource.data.permissions).affectedKeys()
          .hasOnly(["canEditStudentPackageCounts", "canManageOwnLessonDeductions"]) &&
        (!("canEditStudentPackageCounts" in request.resource.data.permissions) ||
          request.resource.data.permissions.canEditStudentPackageCounts is bool) &&
        (!("canManageOwnLessonDeductions" in request.resource.data.permissions) ||
          request.resource.data.permissions.canManageOwnLessonDeductions is bool);
    }

    function myStudentId(academyId) {
      return myMembership(academyId).studentId;
    }

    function studentGroupAccessPath(academyId, groupClassId, studentId) {
      return /databases/$(database)/documents/studentGroupAccess/$(academyId + "__" + groupClassId + "__" + studentId);
    }

    function myStudentGroupAccessPath(academyId, groupClassId) {
      return studentGroupAccessPath(academyId, groupClassId, myStudentId(academyId));
    }

    function studentGroupAccessSummaryPath(academyId, studentId) {
      return /databases/$(database)/documents/studentGroupAccessSummary/$(academyId + "__" + studentId);
    }

    function myStudentGroupAccessSummaryPath(academyId) {
      return studentGroupAccessSummaryPath(academyId, myStudentId(academyId));
    }

    function isCurrentStudent(academyId, studentId) {
      return hasStudentIdentity(academyId) &&
        studentId is string &&
        studentId != "" &&
        myStudentId(academyId) == studentId;
    }

    function studentGroupAccessSummaryIncludesGroupClass(summaryPath, academyId, studentId, groupClassId) {
      let summary = get(summaryPath).data;
      return exists(summaryPath) &&
        summary.academyId == academyId &&
        summary.studentId == studentId &&
        summary.groupClassIds is list &&
        groupClassId in summary.groupClassIds;
    }

    function isKnownGroupCourseType(groupCourseType) {
      return groupCourseType in [
        "free_talking",
        "intermediate_conversation",
        "beginner_conversation",
        "general_conversation"
      ];
    }

    function studentGroupAccessSummaryIncludesGroupCourseType(summaryPath, academyId, studentId, groupCourseType) {
      let summary = get(summaryPath).data;
      return exists(summaryPath) &&
        summary.academyId == academyId &&
        summary.studentId == studentId &&
        groupCourseType is string &&
        isKnownGroupCourseType(groupCourseType) &&
        summary.groupCourseTypes is list &&
        groupCourseType in summary.groupCourseTypes;
    }

    function hasActiveStudentGroupAccessForStudent(academyId, studentId, groupClassId) {
      return isCurrentStudent(academyId, studentId) &&
        groupClassId is string &&
        groupClassId != "" &&
        studentGroupAccessSummaryIncludesGroupClass(
          studentGroupAccessSummaryPath(academyId, studentId),
          academyId,
          studentId,
          groupClassId
        );
    }

    function hasActiveStudentGroupAccess(academyId, groupClassId) {
      return hasActiveStudentGroupAccessForStudent(
        academyId,
        myStudentId(academyId),
        groupClassId
      );
    }

    function hasActiveStudentGroupCourseTypeAccessForStudent(academyId, studentId, groupCourseType) {
      return isCurrentStudent(academyId, studentId) &&
        studentGroupAccessSummaryIncludesGroupCourseType(
          studentGroupAccessSummaryPath(academyId, studentId),
          academyId,
          studentId,
          groupCourseType
        );
    }

    function hasActiveStudentGroupLessonAccessForStudent(academyId, studentId, groupClassId, groupCourseType) {
      return (
        groupClassId is string &&
        groupClassId != "" &&
        hasActiveStudentGroupAccessForStudent(academyId, studentId, groupClassId)
      ) || hasActiveStudentGroupCourseTypeAccessForStudent(academyId, studentId, groupCourseType);
    }

    function hasActiveStudentGroupLessonAccess(academyId, groupClassId, groupCourseType) {
      return hasActiveStudentGroupLessonAccessForStudent(
        academyId,
        myStudentId(academyId),
        groupClassId,
        groupCourseType
      );
    }

    function groupLessonPath(lessonId) {
      return /databases/$(database)/documents/groupLessons/$(lessonId);
    }

    function groupLessonReservationPath(academyId, lessonId, studentId) {
      return /databases/$(database)/documents/groupLessonReservations/$(academyId + "__" + lessonId + "__" + studentId);
    }

    function myGroupLessonReservationPath(academyId, lessonId) {
      return groupLessonReservationPath(academyId, lessonId, myStudentId(academyId));
    }

    function studentPrivateAccessSummaryPath(academyId, studentId) {
      return /databases/$(database)/documents/studentPrivateAccessSummary/$(academyId + "__" + studentId);
    }

    function myStudentPrivateAccessSummaryPath(academyId) {
      return studentPrivateAccessSummaryPath(academyId, myStudentId(academyId));
    }

    function myPrivateTeacherKeys(academyId) {
      return get(myStudentPrivateAccessSummaryPath(academyId)).data.teacherKeys;
    }

    function myPrivateActivePackageIds(academyId) {
      return get(myStudentPrivateAccessSummaryPath(academyId)).data.activePackageIds;
    }

    function hasPrivateTeacherAccess(academyId, teacher) {
      return hasStudentIdentity(academyId) &&
        exists(myStudentPrivateAccessSummaryPath(academyId)) &&
        myPrivateTeacherKeys(academyId) is list &&
        myPrivateActivePackageIds(academyId) is list &&
        myPrivateActivePackageIds(academyId).size() > 0 &&
        teacher is string &&
        teacher != "" &&
        teacher in myPrivateTeacherKeys(academyId);
    }

    function hasPrivateAllowedSlotAccess(academyId, slotId) {
      let summaryPath = myStudentPrivateAccessSummaryPath(academyId);
      let summary = get(summaryPath).data;
      return hasStudentIdentity(academyId) &&
        slotId is string &&
        slotId != "" &&
        exists(summaryPath) &&
        summary.academyId == academyId &&
        summary.studentId == myStudentId(academyId) &&
        (
          (
            summary.allowedSlotIds is list &&
            slotId in summary.allowedSlotIds
          ) ||
          (
            summary.allowedPrivateLessonSlotIds is list &&
            slotId in summary.allowedPrivateLessonSlotIds
          )
        );
    }

    function privateSlotBelongsToTeacher(data) {
      return isAcademyTeacherOrStaff(data.academyId) &&
        data.teacher is string &&
        data.teacher == myAcademyTeacherName(data.academyId);
    }

    function privateSlotVisibleToCurrentStudent(data, slotId) {
      return hasStudentIdentity(data.academyId) &&
        data.status in ["open", "reserved"] &&
        (
          data.reservedStudentId == myStudentId(data.academyId) ||
          hasPrivateAllowedSlotAccess(data.academyId, slotId) ||
          (
            data.eligibleStudentIds is list &&
            myStudentId(data.academyId) in data.eligibleStudentIds
          ) ||
          hasPrivateTeacherAccess(data.academyId, data.teacherUid) ||
          hasPrivateTeacherAccess(data.academyId, data.teacherKey) ||
          hasPrivateTeacherAccess(data.academyId, data.teacher) ||
          hasPrivateTeacherAccess(data.academyId, data.teacherName)
        );
    }

    function privateLessonSlotPath(slotId) {
      return /databases/$(database)/documents/privateLessonSlots/$(slotId);
    }

    function privateLessonReservationPath(academyId, slotId, studentId) {
      return /databases/$(database)/documents/privateLessonReservations/$(academyId + "__" + slotId + "__" + studentId);
    }

    function studentOwnsReservationForStudent(data, studentId) {
      return isCurrentStudent(data.academyId, studentId) &&
        data.studentId is string &&
        data.studentId == studentId;
    }

    function studentOwnsReservation(data) {
      return studentOwnsReservationForStudent(data, myStudentId(data.academyId));
    }

    function validStudentGroupAccessShape(data) {
      return data.groupClassId is string &&
        data.groupClassId != "" &&
        data.studentId is string &&
        data.studentId != "" &&
        data.groupStudentId is string &&
        data.packageId is string &&
        data.status in ["active", "ended"] &&
        data.studentStatus in ["active", "onBreak"];
    }

    function validTeacherGroupClassShape(data) {
      return data.keys().hasOnly([
          "academyId",
          "name",
          "teacher",
          "teacherName",
          "maxStudents",
          "time",
          "subject",
          "weekdays",
          "recurrenceMode",
          "groupCourseType",
          "createdAt",
          "updatedAt"
        ]) &&
        data.academyId is string &&
        data.academyId != "" &&
        data.name is string &&
        data.name != "" &&
        data.teacher is string &&
        data.teacher == myAcademyTeacherName(data.academyId) &&
        (!("teacherName" in data.keys()) ||
          (data.teacherName is string &&
            data.teacherName == myAcademyTeacherName(data.academyId))) &&
        data.maxStudents is int &&
        data.maxStudents >= 1 &&
        data.time is string &&
        data.time.matches("^\\d{2}:\\d{2}$") &&
        data.subject is string &&
        data.subject != "" &&
        data.weekdays is list &&
        data.weekdays.size() > 0 &&
        (!("groupCourseType" in data.keys()) ||
          (data.groupCourseType is string && isKnownGroupCourseType(data.groupCourseType))) &&
        (!("recurrenceMode" in data.keys()) || data.recurrenceMode == "fixedWeekdays") &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validStudentReservationCreateShape() {
      return request.resource.data.keys().hasOnly([
          "academyId",
          "lessonId",
          "groupClassId",
          "studentId",
          "status",
          "source",
          "createdAt",
          "updatedAt",
          "cancelledAt"
        ]) &&
        request.resource.data.lessonId is string &&
        request.resource.data.groupClassId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.status == "active" &&
        request.resource.data.source == "student" &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.cancelledAt == null;
    }

    function validStudentReservationPairingOnCreateForStudent(studentId) {
      let lesson = get(groupLessonPath(request.resource.data.lessonId)).data;
      let lessonAfter = getAfter(groupLessonPath(request.resource.data.lessonId)).data;
      return isCurrentStudent(request.resource.data.academyId, studentId) &&
        request.resource.data.studentId == studentId &&
        lesson.academyId == request.resource.data.academyId &&
        lesson.groupClassId == request.resource.data.groupClassId &&
        lesson.isBookable == true &&
        hasActiveStudentGroupLessonAccessForStudent(
          request.resource.data.academyId,
          studentId,
          request.resource.data.groupClassId,
          lesson.groupCourseType
        ) &&
        lessonAfter.bookedCount == lesson.bookedCount + 1;
    }

    function validStudentReservationPairingOnCreate() {
      return validStudentReservationPairingOnCreateForStudent(
        myStudentId(request.resource.data.academyId)
      );
    }

    function validStudentReservationPairingOnUpdateForStudent(studentId) {
      let lesson = get(groupLessonPath(resource.data.lessonId)).data;
      let lessonAfter = getAfter(groupLessonPath(resource.data.lessonId)).data;
      return resource.data.source == "student" &&
        studentOwnsReservationForStudent(resource.data, studentId) &&
        resource.data.groupClassId is string &&
        resource.data.groupClassId != "" &&
        lesson.academyId == resource.data.academyId &&
        lesson.groupClassId == resource.data.groupClassId &&
        (
          (
            resource.data.status == "cancelled" &&
            request.resource.data.status == "active" &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.cancelledAt == null &&
            lesson.isBookable == true &&
            hasActiveStudentGroupLessonAccessForStudent(
              resource.data.academyId,
              studentId,
              resource.data.groupClassId,
              lesson.groupCourseType
            ) &&
            lessonAfter.bookedCount == lesson.bookedCount + 1
          ) ||
          (
            resource.data.status == "active" &&
            request.resource.data.status == "cancelled" &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.cancelledAt == request.time &&
            lessonAfter.bookedCount == lesson.bookedCount - 1
          )
        );
    }

    function validStudentReservationPairingOnUpdate() {
      return validStudentReservationPairingOnUpdateForStudent(
        myStudentId(resource.data.academyId)
      );
    }

    function reservationActiveBeforeAndCancelledAfter(reservationPath) {
      return exists(reservationPath) &&
        get(reservationPath).data.status == "active" &&
        getAfter(reservationPath).data.status == "cancelled";
    }

    function reservationAfterMatchesStudentBooking(
      reservationPath,
      academyId,
      lessonId,
      groupClassId,
      studentId
    ) {
      let reservation = getAfter(reservationPath).data;
      return reservation.academyId == academyId &&
        reservation.lessonId == lessonId &&
        reservation.groupClassId == groupClassId &&
        reservation.studentId == studentId &&
        reservation.source == "student" &&
        reservation.status == "active" &&
        reservation.updatedAt == request.time;
    }

    function validStudentBookedCountIncreasePairing(lessonId, studentId) {
      return request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
        resource.data.isBookable == true &&
        reservationAfterMatchesStudentBooking(
          groupLessonReservationPath(resource.data.academyId, lessonId, studentId),
          resource.data.academyId,
          lessonId,
          resource.data.groupClassId,
          studentId
        );
    }

    function validStudentBookedCountDecreasePairing(lessonId, studentId) {
      return request.resource.data.bookedCount == resource.data.bookedCount - 1 &&
        reservationActiveBeforeAndCancelledAfter(
          groupLessonReservationPath(resource.data.academyId, lessonId, studentId)
        );
    }

    function validStudentBookedCountPairingForStudent(lessonId, studentId) {
      return isCurrentStudent(resource.data.academyId, studentId) &&
        lessonId is string &&
        lessonId != "" &&
        resource.data.groupClassId is string &&
        resource.data.groupClassId != "" &&
        request.resource.data.groupClassId == resource.data.groupClassId &&
        (
          validStudentBookedCountIncreasePairing(lessonId, studentId) ||
          validStudentBookedCountDecreasePairing(lessonId, studentId)
        );
    }

    function validStudentBookedCountPairing(lessonId) {
      return validStudentBookedCountPairingForStudent(
        lessonId,
        myStudentId(resource.data.academyId)
      );
    }

    function validStudentGroupAccessSummaryShape(data) {
      return data.keys().hasOnly([
          "academyId",
          "studentId",
          "groupClassIds",
          "groupCourseTypes",
          "createdAt",
          "updatedAt"
        ]) &&
        data.academyId is string &&
        data.academyId != "" &&
        data.studentId is string &&
        data.studentId != "" &&
        (!("groupClassIds" in data.keys()) || data.groupClassIds is list) &&
        (!("groupCourseTypes" in data.keys()) || data.groupCourseTypes is list);
    }

    function validStudentPrivateAccessSummaryShape(data) {
      return data.keys().hasOnly([
          "academyId",
          "studentId",
          "teacherKeys",
          "activePackageIds",
          "allowedSlotIds",
          "allowedPrivateLessonSlotIds",
          "privateSlotBookingPilotEnabled",
          "createdAt",
          "updatedAt"
        ]) &&
        data.academyId is string &&
        data.academyId != "" &&
        data.studentId is string &&
        data.studentId != "" &&
        (!("teacherKeys" in data.keys()) || data.teacherKeys is list) &&
        (!("activePackageIds" in data.keys()) || data.activePackageIds is list) &&
        (!("allowedSlotIds" in data.keys()) || data.allowedSlotIds is list) &&
        (!("allowedPrivateLessonSlotIds" in data.keys()) ||
          data.allowedPrivateLessonSlotIds is list) &&
        (!("privateSlotBookingPilotEnabled" in data.keys()) ||
          data.privateSlotBookingPilotEnabled is bool);
    }

    function validPrivateSlotBaseShape(data) {
      return data.keys().hasOnly([
          "academyId",
          "teacher",
          "teacherName",
          "teacherKey",
          "teacherUid",
          "teacherEmail",
          "date",
          "time",
          "subject",
          "capacity",
          "reservedCount",
          "startAt",
          "bookingOpensAt",
          "bookingClosesAt",
          "durationMinutes",
          "status",
          "eligibleStudentIds",
          "reservedStudentId",
          "reservationId",
          "slotType",
          "availabilityTemplateId",
          "isGeneratedFromTemplate",
          "fixedStudentId",
          "fixedStudentName",
          "releasedFromFixed",
