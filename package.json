{
  "name": "firebase-admin-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.20.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "node scripts/validate-firebase-env.mjs e2e && vite --mode e2e --host 127.0.0.1",
    "build": "vite build",
    "build:prod": "node scripts/validate-firebase-env.mjs production && vite build --mode production",
    "build:e2e": "node scripts/validate-firebase-env.mjs e2e && vite build --mode e2e",
    "preview": "vite preview",
    "seed:e2e:users": "node scripts/seed-e2e-users.cjs",
    "test:e2e": "npm run seed:e2e:users && PW_FIREBASE_ENV_MODE=e2e playwright test",
    "test:e2e:chromium": "npm run seed:e2e:users && PW_FIREBASE_ENV_MODE=e2e playwright test --project=chromium",
    "test:e2e:ui": "PW_FIREBASE_ENV_MODE=e2e playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify:e2e": "node scripts/run-release-verification.mjs --suite=e2e",
    "verify:hosted": "node scripts/run-release-verification.mjs --suite=hosted",
    "verify:core": "node scripts/run-release-verification.mjs --suite=core",
    "verify:dist": "node scripts/scan-built-output.mjs",
    "verify:ops-scripts": "node scripts/run-release-verification.mjs --suite=ops-scripts",
    "verify:all": "node scripts/run-release-verification.mjs --suite=all",
    "backfill:academy-id": "node scripts/backfill-academy-id.mjs"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^10.12.0",
    "firebase-admin": "^13.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1"
  }
}
